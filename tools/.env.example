# Skopiuj do tools/.env, jeśli chcesz zmienić domyślne wartości.
POSTGRES_USER=questlog
POSTGRES_PASSWORD=questlog
POSTGRES_DB=questlog

# Klucz do podpisywania tokenów logowania (JWT). Na produkcji ustaw własny, długi i losowy.
SECRET_KEY=dev-secret-change-me

# Jedyny port wystawiony na hosta (Caddy).
FRONTEND_PORT=8080
