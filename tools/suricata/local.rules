# Własne reguły IDS dla QuestLog (sid 1000001+), obok zestawu ET Open.
# TLS kończy się na load balancerze, więc na VM (port 80) Suricata widzi odszyfrowany HTTP,
# łącznie z body, którego reguła WAF w Cloudflare nie sprawdza (patrzy tylko na query).

alert http any any -> $HOME_NET 80 (msg:"QUESTLOG SQLi w body zadania API"; flow:established,to_server; http.uri; content:"/api/"; startswith; http.request_body; content:"union"; nocase; content:"select"; nocase; distance:0; classtype:web-application-attack; sid:1000001; rev:1;)

alert http any any -> $HOME_NET 80 (msg:"QUESTLOG XSS w body zadania API"; flow:established,to_server; http.uri; content:"/api/"; startswith; http.request_body; content:"<script"; nocase; classtype:web-application-attack; sid:1000002; rev:1;)

alert http any any -> $HOME_NET 80 (msg:"QUESTLOG proba pobrania plikow konfiguracyjnych (.env/.git)"; flow:established,to_server; http.uri; pcre:"/\/\.(env|git)(\/|\?|$)/"; classtype:attempted-recon; sid:1000003; rev:1;)

# Żądanie bez CF-Connecting-IP = ktoś ominął Cloudflare (wszedł prosto na IP load balancera).
# Health check LB nie ma tego nagłówka, więc go pomijamy; limit 1 alert/min (źródłem jest zawsze LB).
alert http any any -> $HOME_NET 80 (msg:"QUESTLOG ruch z pominieciem Cloudflare"; flow:established,to_server; http.uri; content:!"/api/health"; http.header_names; content:!"|0d 0a|CF-Connecting-IP|0d 0a|"; nocase; threshold:type limit, track by_dst, count 1, seconds 60; classtype:policy-violation; sid:1000004; rev:1;)
